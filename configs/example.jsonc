// VFI Hard Miner — 带注释的配置参考
// 用法：复制 example.json（不是本文件），按下方说明修改。
// 本文件为 JSONC 格式（JSON with Comments），运行时不能直接加载。
// VS Code 会将 .jsonc 渲染为带语法高亮的注释，适合作为字段说明文档。
{
  // ─────────────────────────────────────────────────────
  // data: 输入数据配置
  // ─────────────────────────────────────────────────────
  "data": {
    // 游戏连续帧的根目录。工具会递归扫描该目录下所有符合
    // frame_regex 的文件，按 (video, frame) 分组排序后建立索引。
    "root": "/data/game_name",

    // 帧文件名匹配正则。必须包含三个具名捕获组：
    //   video — 视频/场景标识符（路径前缀或场景名）
    //   frame — 帧编号，必须为纯数字
    //   ext   — 文件扩展名
    // 下面的默认值匹配形如 "scene_a00042.png" 的命名：
    "frame_regex": "^(?P<video>.*?)(?P<frame>\\d{5})\\.(?P<ext>png|jpg|jpeg)$",

    // 帧号位数。null 表示从 frame_regex 自动推断（推荐）。
    // 仅在无法从正则推断时手动指定，例如帧号无前导零时设为 1。
    "frame_digits": null,

    // 帧采样步长。stride=1 表示每一帧都参与建立 triplet（最密集）。
    // stride=2 表示每隔一帧取一对，可在数据量极大时加速索引但会遗漏帧间样本。
    "stride": 1
  },

  // ─────────────────────────────────────────────────────
  // model: 当前 VFI 模型配置（主挖掘模型）
  // ─────────────────────────────────────────────────────
  "model": {
    // 模型工厂，两种写法：
    //   短名称   — 直接使用 models/ 包中的文件名，例如 "unet" 对应
    //              src/vfi_hard_miner/models/unet.py 中的 create_model()
    //   完整路径 — "my_project.adapter:create_model"（保持向后兼容）
    "factory": "unet",

    // 权重文件路径（state_dict 格式）。null 表示随机初始化，
    // 仅用于开发调试；生产配置必须指向真实 checkpoint。
    "checkpoint": null,

    // 网络固定输入尺寸（高×宽，单位像素）。
    // worker 会逐帧双线性缩放并直接写入网络尺寸 batch；不会先 stack
    // 整个原分辨率 float32 batch。ModelAdapter 仍会校验最终输入尺寸。
    "input_height": 540,
    "input_width": 960,

    // NPU 主推理批大小，只影响网络分辨率输入与低分辨率模型输出。
    // 原分辨率 uint8/float32 生命周期已与该值解耦。64 是首轮起点；
    // A3 应用同一 chunk 对比 16/32/64 的总耗时后选择，而非只看 NPU 前向。
    "batch_size": 64,

    // mask0 的语义角色，决定后处理时如何将 mask0/mask1 用于融合：
    //   "warp0_weight" — mask0 是 frame0 backward warp 的混合权重（默认）
    //   "warp1_weight" — mask0 是 frame1 backward warp 的混合权重
    // 具体含义见 docs/model_adapter.md。
    "mask0_role": "warp0_weight",

    // flow 上采样时 F.interpolate 的 align_corners 参数。
    // false（默认）与大多数现代框架的行为一致；
    // 若模型训练时使用 true，则需改为 true 以保持一致性。
    "align_corners": false,

    // backward warp 时超出图像边界的填充方式，对应 grid_sample 的 padding_mode：
    //   "border"     — 复制边缘像素（推荐，对遮挡区域更稳定）
    //   "zeros"      — 填充 0
    //   "reflection" — 镜像填充
    "padding_mode": "border",

    // flow 向量的单位制：
    //   "input_pixels"   — flow 值以原始输入帧的像素为单位（推荐）
    //   "network_pixels" — flow 值以网络固定输入尺寸的像素为单位
    // 绝大多数模型输出 network_pixels；设为 input_pixels 时工具会
    // 在后处理中自动做比例换算。
    "flow_units": "input_pixels",

    // 额外传给 create_model() 的关键字参数，与 factory_kwargs 字段对应。
    // 这里的 key 必须与 create_model() 的参数名完全匹配。
    // UNet 示例：base_channels 控制所有特征图的宽度倍数。
    "factory_kwargs": {
      "base_channels": 32
    }
  },

  // ─────────────────────────────────────────────────────
  // cgvqm: 候选样本的 R3D 深度时空精判
  // 只处理传统评分已确认的高召回候选，不对全量样本重复运行。
  // ─────────────────────────────────────────────────────
  "cgvqm": {
    // graded_flat 训练输出必须启用，避免仅凭像素误差把简单帧放入 A/B。
    "enabled": true,

    // 所有资源必须预先放入离线包；运行时不会访问网络或自动下载。
    "backbone_checkpoint": "third_party/weights/cgvqm/r3d_18-b3b3357e.pth",
    "calibration_checkpoint": "third_party/weights/cgvqm/cgvqm-2.pickle",

    // auto 跟随主模型后端。启动时先跑一个 probe 子进程探测每个 NPU 的
    // Conv3D 支持；探针失败时，只有 allow_cpu_fallback 为 true 才会明确
    // 记录原因并回退 CPU（否则 fail-loud 中止）。
    "backend": "auto",
    "allow_cpu_fallback": true,
    // 回退 CPU 时改用固定数量的 CPU worker（不再 per-device 起 NPU 数量的
    // 进程），避免 CPU Conv3D 把 8 路并发压垮。仅在触发回退时生效。
    "cpu_fallback_workers": 2,

    // 每个候选使用同一视频内连续 16 个 prediction/GT 中间帧。
    // 首尾使用确定性边界 padding，不跨视频。
    "clip_frames": 16,
    "crop_size": 224,
    // R3D-18 Conv3D 的评分微批次；4 在 224×224×16 clip 下有吞吐与显存余量。
    // 实际批大小仍按 postproc_buffer_mb 预算自动下压（只降不升）。
    "batch_size": 4,
    "candidates_per_task": 32,
    // 跨候选 chunk 复用的上下文缓存（MB/worker）：相邻候选窗口共享大量
    // context 帧，命中即跳过解码与推理；淘汰只会触发重推，评分逐位不变。
    // prediction 以 uint8 缓存（与裁剪路径同一量化公式），单条占用约为
    // float32 的 1/4，同样预算下可多缓存约 4 倍条目。0 表示禁用；视频间自动清空。
    "context_cache_mb": 256,

    // CGVQM 使用 error 方向：越高表示感知劣化越明显。
    "b_error_at": 25.0,
    "a_error_at": 50.0,
    "temporal_persistence_at": 0.35,

    // CGVQM 高响应必须与传统候选区域具有足够空间重叠；
    // 否则属于两种证据冲突，只进入 Review。
    "spatial_overlap_at": 0.35,
    // 相邻 CGVQM 帧均值变化超过该 error 值时，记录 flicker 时序证据。
    "flicker_change_at": 10.0,
    // union crop 仅纳入与候选框 IoU 或 containment ≥ 阈值的上下文框；
    // 过滤掉同 region 内不相关的运动区域，避免 crop 被非候选区域撑大。
    "union_crop_iou_threshold": 0.10
  },

  // ─────────────────────────────────────────────────────
  // thresholds: 困难样本筛选阈值
  // 所有值均为概率，范围 [0, 1]。
  // reject_below < p < accept_at 的样本进入 review 队列。
  // ─────────────────────────────────────────────────────
  "thresholds": {
    // p_wrong 阈值：当前模型在此 triplet 上的错误程度。
    //   低于 wrong_reject_below → 模型没做错，丢弃（不够难）
    //   高于 wrong_accept_at   → 模型确实做错，接受为困难样本
    "wrong_reject_below": 0.20,
    "wrong_accept_at": 0.45,
    // A 级还必须达到的传统结构错误下限。
    "severe_wrong_accept_at": 0.70,

    // p_solvable 阈值：此 triplet 是否在理论上可被模型解决。
    //   低于 solvable_reject_below → 无法解（遮挡/超出运动范围），丢弃
    //   高于 solvable_accept_at   → 可解，保留
    "solvable_reject_below": 0.30,
    "solvable_accept_at": 0.55,

    // 菜单转场特征得分阈值。
    //   低于 review_at  → 忽略此特征
    //   review_at ～ reject_at → 进入人工审核
    //   高于 reject_at  → 识别为 UI 转场，拒绝（此类样本无训练价值）
    "menu_transition_review_at": 0.40,
    "menu_transition_reject_at": 0.70,

    // 前景大幅运动特征得分阈值（人物/车辆等高速运动）。
    //   review_at ～ reject_at 区间的样本优先级降低但不丢弃。
    "foreground_motion_review_at": 0.35,
    "foreground_motion_reject_at": 0.65,

    // 遮挡特征得分阈值（物体进入/离开画面导致的遮挡区域）。
    "occlusion_review_at": 0.40,
    "occlusion_reject_at": 0.70,

    // UI 区域（文字、图标、小地图等）的 priority_weight 下限。
    // 贴边、高边缘密度区域的 priority_weight 会被压低至此值，
    // 防止 UI 元素垄断困难样本名额。
    "ui_priority_floor": 0.35,

    // 非 UI 候选（中央人物/武器结构等）保留的最少名额数。
    // 即使 p_wrong 整体偏低，也至少保留 non_ui_region_reserve 个非 UI 样本。
    "non_ui_region_reserve": 1
  },

  // ─────────────────────────────────────────────────────
  // runtime: 执行环境与并行配置
  // ─────────────────────────────────────────────────────
  "runtime": {
    // 计算后端：
    //   "cpu"  — 纯 CPU，适合开发调试，无需 GPU/NPU
    //   "cuda" — NVIDIA CUDA GPU
    //   "npu"  — Ascend 910B，生产环境推荐
    "backend": "npu",

    // 使用的设备编号列表。
    //   CUDA: 对应 GPU 卡号，如 [0, 1]
    //   NPU:  对应 Ascend 卡号，生产配置通常为 [0,1,2,3,4,5,6,7]
    //   CPU:  忽略此字段（填 [0] 即可）
    "devices": [0, 1, 2, 3, 4, 5, 6, 7],

    // 并行 worker 进程数。每个 worker 独占一块设备、加载一次模型。
    // 通常等于 devices 的长度。任务不足时会自动减少实际启动数量。
    "workers": 8,

    // 每个任务块包含的 triplet 数量。较大的值减少任务分发开销，
    // 但单个任务失败时需重跑更多工作；256 是通常合理的默认值。
    "chunk_triplets": 256,

    // 预取队列深度：图片解码与 NPU 推理的流水线并发深度。
    // 4 表示在 NPU 处理当前批的同时，CPU 已并行解码后续批次。
    // 队列批次保持 uint8，不持有 float32。
    "prefetch": 4,

    // 每个 worker 的并行 PNG 解码线程数。LRU 命中检查仍串行，仅缓存未命中
    // 的解码进线程池（zlib 释放 GIL，有真并行）；事件顺序与单线程逐位一致。
    // 1 = 单线程旧行为；×8 worker 共 32 个解码线程，按物理核数酌减。
    "decode_workers": 4,

    // 每个 worker 的图片解码缓存上限（MB）。帧以 uint8 缓存（比 float32
    // 省 4 倍内存），缓存帧数 = min(本预算 / 单帧字节数, chunk_triplets + 2)。
    // stride=1 时缓存覆盖整个 chunk 即可实现每帧只解码一次；4K 帧约 24MB/帧，
    // 1024MB 约缓存 42 帧，足以覆盖 bs8 在途窗口。内存紧张时下限为 16。
    "decode_cache_mb": 1024,

    // 每个 worker 进程的 CPU 线程数（用于 PyTorch/OpenCV 内部并行）。
    // 多 worker 时建议 cpu_threads_per_worker × workers ≤ 物理核心数。
    "cpu_threads_per_worker": 8,

    // 每个 worker 的 CPU 后处理线程数（重建结果的评分与诊断）。
    // 0 表示自动：结合逻辑核数、worker 数与每进程线程预算计算，并将每个
    // NPU worker 的全分辨率评分 Future 限制为最多 2 个，避免内存带宽争用。
    // 显式 4：×8 worker 共 32 个评分线程（scipy/numpy 释放 GIL 有真并行），
    // 实际在途数量继续受 postproc_buffer_mb 限制。
    "postproc_workers": 4,

    // 每个 worker 的 CPU 后处理完整预留上限（MB）。两阶段回传口径：
    // tier-1 7 通道（prediction+flow）CPU 驻留 + tier-2 11 通道（warp+mask）
    // 设备端驻留（仅候选按需回传）+ Future 持有的 9 通道 float32 输入、
    // 24 plane 评分 scratch、当前微批次 6 通道 endpoint stack transient
    // 和固定开销。准入在原分辨率 float32 转换与 reconstruction 之前完成；
    // 单样本超预算时独占并记录 oversize=1。
    "postproc_buffer_mb": 2048,

    // 每微批次最多处理的样本数（0 = 自动按预算推导）。
    // 自动推导将 postproc_buffer_mb/workers 预算除以单样本 retained+transient
    // 成本，1080p A3 配置下（4 workers × 512 MiB/Future）结果为 1，
    // 导致 64 次单样本 grid_sample。显式设置为 8 可让每次 F.grid_sample
    // 以 batch=8 运行，提升 NPU 向量化利用率；内存安全性由准入门控保证。
    "postproc_microbatch_size": 8,

    // 每个 worker 在正式推理前运行的预热批数。
    // 预热使 NPU JIT / 算子缓存充分预热，避免前几批延迟偏高影响统计。
    "warmup_batches": 2,

    // 任务租约时长（秒）。worker 在领取任务后必须在此时间内完成
    // 并续约，否则其他 worker 可重新领取该任务（防止 worker 崩溃
    // 导致任务永久卡死）。建议设为单块任务预期耗时的 3～5 倍。
    "lease_seconds": 1800,

    // 推理精度：
    //   "float32" — 最高精度，Ascend 910B 生产必须使用此值
    //   "float16" — 半精度，CUDA 调试/加速时可使用
    "precision": "float32",

    // 重建（flow 上采样 + backward warp + mask 融合）的计算设备：
    //   "auto"   — 启动时探测加速卡 grid_sample 能力，支持则在加速卡上重建，
    //              否则回退 CPU 参考实现（stderr 会打印一行回退提示）
    //   "device" — 强制在加速卡上重建（不支持时直接报错）
    //   "cpu"    — 始终使用 CPU FP32 参考实现（校准基线；与旧版本行为一致）
    // 生产环境用 "device" fail-loud：避免探测失败时静默回退 CPU 参考实现
    // 造成吞吐灾难。加速卡重建与 CPU 参考之间存在 fp32 级舍入差异，属正常现象。
    "reconstruction": "device",

    // SQLite 状态数据库路径。记录任务进度、租约和结果，
    // 支持断点续跑——重启工具后会自动跳过已完成任务。
    // 每次实验建议使用独立路径（与 run_dir 保持一致）。
    "state_db": "runs/state.sqlite3",

    // 本次运行的输出根目录。index 首次运行时会写入不可变快照
    // execution.snapshot.json；同一 run_dir 不能混用不同 checkpoint
    // 或数据源的结果。每次新实验请使用新目录。
    "run_dir": "runs/game_name"
  },

  // ─────────────────────────────────────────────────────
  // output: 结果输出配置
  // ─────────────────────────────────────────────────────
  "output": {
    // 训练帧输出目录名（相对于 data.root）。目录内固定只有 A/ 与 B/。
    "hard_case_dir": "extremely_hard_case",

    // 诊断可视化拼图（对比图）的输出目录名（相对于 run_dir）。
    // 每个困难中心生成一张拼图：img0 / 预测 / img1 / GT / 差异图。
    "visualization_dir": "extremely_hard_case_visualization",

    // JSONL 清单文件名（位于 run_dir 根目录）。
    // 每行一条记录，包含 A/B/Review/Reject、三帧映射、传统与 CGVQM 证据。
    "manifest_name": "hard_case_manifest.jsonl",

    // 训练数据固定使用原文件字节复制，并在复制后校验 SHA-256。
    "link_mode": "copy",

    // A/B 平铺布局。A/B 内不创建视频、segment 或数字编号子目录；
    // 文件 basename 原样保留，同级同名异源会明确失败。
    "layout": "graded_flat",

    // 每个视频完成 CGVQM 分级后立即复制到运行专属暂存区；
    // finalize 只验证并复用，正式目录仍统一原子切换。
    "materialize_strategy": "per_video",

    // 是否为 review 级别的样本（p_wrong 处于中间区间）也生成诊断图。
    // false 可显著减少诊断阶段的 I/O 和存储占用。
    "save_review": false,

    // 2 行 × 5 列诊断图的单格宽度和 JPEG 质量。训练帧不受此设置影响。
    "visualization_width": 480,
    "visualization_quality": 92
  }
}
